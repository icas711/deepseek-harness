# DeepSeek API Configuration
DEEPSEEK_API_KEY=

# Z.ai (GLM) API Configuration
# Get your API key from https://open.bigmodel.cn/
ZAI_API_KEY=

# Telemetry Configuration
# Controls what telemetry data is collected and shared
# Options: DISABLED, FULL, FEEDBACK_ONLY
DSH_TELEMETRY_MODE=FEEDBACK_ONLY

# OTLP endpoint for telemetry export (optional)
DSH_TELEMETRY_OTLP_URL=

# Set any non-empty value to completely disable telemetry
# Overrides DSH_TELEMETRY_MODE if set
DSH_TELEMETRY_DISABLED=

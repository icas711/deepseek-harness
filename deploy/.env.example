# Шаблон deploy/.env — скопируйте в .env и заполните. Настоящий .env
# никогда не коммитится (уже в .gitignore).
#
#   cp .env.example .env && chmod 600 .env

# Ключ модели DeepSeek — обязателен: без него агент не ответит.
DEEPSEEK_API_KEY=

# Пользователи веб-GUI — обязательны. Формат: логин:scrypt-хэш, записи через
# запятую. Готовую строку печатает генератор хэшей:
#
#   node deploy/hash-password.mjs логин
#
# ВАЖНО: вставляйте напечатанную строку ЦЕЛИКОМ, вместе с одинарными
# кавычками. Compose разворачивает $ в значениях .env и молча портит
# scrypt-хэш (вида scrypt$16384$8$1$salt$key), принимая $16384 и $8 за
# переменные; одинарные кавычки делают значение буквальным. Пример:
#
#   DSH_WEB_USERS='alice:scrypt$16384$8$1$ab12..$cd34..,bob:scrypt$16384$8$1$ef56..$ab78..'
#
# Несколько пользователей — запустите генератор по разу на каждого и
# перечислите записи через запятую внутри одних кавычек.
#
# Каждый логин — отдельный «кабинет»: своя папка workspace/<логин> и свои
# сессии; чужие диалоги и файлы не видны. Новый вход под тем же логином
# завершает его предыдущую сессию. Смена пароля (новый хэш) отзывает сессии
# этого логина.
DSH_WEB_USERS=

# Логины-админы через запятую (необязательно): видят сессии и рабочие папки
# всех пользователей. Логин должен присутствовать и в DSH_WEB_USERS.
DSH_WEB_ADMINS=

# Внешний адрес сервера, каким его видит браузер: домен (лучше) или IP.
# Домен без порта покрывает любой порт — и HTTPS через Caddy, и прямой доступ.
# Запись попадает в --trusted-host (browser-trust fence): адрес в строке
# браузера должен совпадать с ним, иначе /api отвечает 403.
DSH_PUBLIC_HOST=dsh.example.com

# Токен бота Telegram для уведомлений о задачах (необязательно; см. раздел
# «Уведомления Telegram» в deploy/README.md). Получите у @BotFather и вставьте
# сюда; пусто — уведомления выключены, привязка в GUI отвечает отказом.
DSH_TELEGRAM_BOT_TOKEN=

# База ссылок на сессии в текстах уведомлений (необязательно): адрес, по
# которому открывается GUI. Обычно совпадает с DSH_PUBLIC_HOST.
DSH_WEB_URL=https://dsh.example.com
